*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg-info/
.eggs/
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
!.env.example
*.pem
*.key
secrets.*
credentials.*

# Jupyter
.ipynb_checkpoints/
.ipython/
.profile/

# Editors and operating systems
.vscode/
