htmlcov/

# Logs and temporary files
*.log
*.tmp
*.bak
*.orig
.cache/
tmp/
temp/

# Local datasets and processed patient data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Keep split manifests / metadata under version control if they contain
# only the required non-identifying IDs and counts.
# Review carefully before committing any patient-related information.

# Model weights, checkpoints, and large generated artifacts
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
*.h5
*.keras
models/checkpoints/
models/weights/
checkpoints/
outputs/
artifacts/

# Hugging Face / Transformers local caches
.cache/huggingface/
huggingface/
transformers_cache/

# Experiment outputs (commit selected, reviewed results intentionally)
# Uncomment to ignore all local experiment outputs:
# experiments/**/outputs/
# benchmarks/local/

# Node / frontend (if using a JS-based frontend)
node_modules/
.npm/
.next/
.nuxt/
dist/
coverage/
